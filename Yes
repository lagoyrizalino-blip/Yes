local function startPlatformLock(cf)
    platformLockCFrame = cf
    if platformLockConnection then return end
    platformLockConnection = RunService.Heartbeat:Connect(function()
        if not platformLockCFrame then return end
        if not FARM_ENABLED or FARMING_MODE ~= "Teleport" then return end
        if PINATA_ENABLED or CANDY_ENABLED then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = platformLockCFrame
        end
    end)
end
local function stopPlatformLock()
    platformLockCFrame = nil
    if platformLockConnection then platformLockConnection:Disconnect(); platformLockConnection = nil end
end

-- ========== TWEENING ==========
local currentTween = nil
local function forceTweenTo(destinationCFrame, durationOverride)
    if not FARM_ENABLED and not CANDY_ENABLED then return end
    if destinationCFrame.Position.Y < MIN_SAFE_Y then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not rootPart or not humanoid then return end
    local duration = durationOverride
    if not duration then
        local distance = (rootPart.Position - destinationCFrame.Position).Magnitude
        duration = math.max(0.05, distance / TWEEN_SPEED)
    end
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destinationCFrame})
    pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    local forceConnection
    forceConnection = RunService.Heartbeat:Connect(function()
        if not FARM_ENABLED and not CANDY_ENABLED then
            if forceConnection then forceConnection:Disconnect() end
            return
        end
        if character and rootPart and humanoid then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    currentTween:Play()
    currentTween.Completed:Wait()
    if forceConnection then forceConnection:Disconnect() end
end

-- ========== INSTANT TELEPORT ==========
local function instantTeleportTo(destinationCFrame)
    if destinationCFrame.Position.Y < MIN_SAFE_Y then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not rootPart or not humanoid then return end
    pcall(function() character:PivotTo(destinationCFrame) end)
    rootPart.CFrame = destinationCFrame
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end

