    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    hum.Died:Connect(function()
        if FARM_ENABLED or CANDY_ENABLED or PINATA_ENABLED then
            isDead = true
            clearAllChams()
            if _G.setStatus then _G.setStatus("Died! Respawning...", THEME.DANGER) end
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h.PlatformStand = false; h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        end
    end)
end
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    task.wait(0.5)
    setupDeathListener(char)
    if FARM_ENABLED or CANDY_ENABLED or PINATA_ENABLED then setNoclip(true) end
