-- ========== SKY PLATFORM ==========
local skyPlatform = nil
local function getMapCenter()
    local center = Vector3.new(0, 0, 0)
    local map = workspace:FindFirstChild("Map")
    if map then
        local parts = {}
        for _, d in ipairs(map:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Y > MIN_SAFE_Y then
                table.insert(parts, d.Position)
            end
        end
        if #parts > 0 then
            local sum = Vector3.zero
            for _, p in ipairs(parts) do sum = sum + p end
            center = sum / #parts
        end
    else
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then center = Vector3.new(hrp.Position.X, 0, hrp.Position.Z) end
    end
    return center
end

local function ensureSkyPlatform()
    if skyPlatform and skyPlatform.Parent then return skyPlatform end
    local center = getMapCenter()
    local plat = Instance.new("Part")
    plat.Name = "AutoFarmSkyPlatform"
    plat.Anchored = true
    plat.CanCollide = true
    plat.Size = Vector3.new(TP_PLATFORM_SIZE, 1, TP_PLATFORM_SIZE)
    plat.Position = Vector3.new(center.X, center.Y + TP_SKY_HEIGHT, center.Z)
    plat.Material = Enum.Material.Neon
    plat.Color = Color3.fromRGB(80, 140, 255)
    plat.Transparency = 0.3
    plat.TopSurface = Enum.SurfaceType.Smooth
    plat.BottomSurface = Enum.SurfaceType.Smooth
    plat.Parent = workspace
    skyPlatform = plat
    return plat
end

local function removeSkyPlatform()
    if skyPlatform then skyPlatform:Destroy(); skyPlatform = nil end
end

local function getSkyPlatformCFrame()
    local plat = ensureSkyPlatform()
    if not plat then return nil end
    return plat.CFrame + Vector3.new(0, 3, 0)
end

