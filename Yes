-- ========== CHAMS SYSTEM ==========
local activeChams = {}
local function clearAllChams()
    for _, cham in pairs(activeChams) do
        if cham and cham.Parent then cham:Destroy() end
    end
    activeChams = {}
end
local function applyChams(instance, index, color)
    if not instance then return end
    if not activeChams[index] or not activeChams[index].Parent then
        local h = Instance.new("Highlight")
        h.Name = "TargetCham"
        h.FillColor = color or CHAMS_COLOR
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Adornee = instance
        h.Parent = instance
        activeChams[index] = h
    end
end

-- ========== FAST MODE LOGIC ==========
local function applyFastMode()
    if FAST_MODE_ENABLED then return end
    FAST_MODE_ENABLED = true
    local map = workspace:FindFirstChild("Map")
    local halloween = map and map:FindFirstChild("Halloween")
    if halloween then
        hiddenHalloweenModel = halloween
        hiddenHalloweenParent = halloween.Parent
        halloween.Parent = nil
    end
    removedTextures = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("ForceField") then
            if obj.Parent then
                removedTextures[obj] = { Parent = obj.Parent }
                obj.Parent = nil
            end
        end
    end
    savedLighting = {
        ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
        FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }
    pcall(function()
        Lighting.ClockTime = 14
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.fromRGB(150,150,150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150,150,150)
        Lighting.FogEnd = 100000
        Lighting.FogStart = 100000
        Lighting.GlobalShadows = true
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
    end)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky then
        removedSky = sky; removedSkyParent = sky.Parent; sky.Parent = nil
    end
end

local function removeFastMode()
    if not FAST_MODE_ENABLED then return end
    FAST_MODE_ENABLED = false
    if hiddenHalloweenModel and hiddenHalloweenParent then
        hiddenHalloweenModel.Parent = hiddenHalloweenParent
        hiddenHalloweenModel = nil; hiddenHalloweenParent = nil
    end
    for obj, data in pairs(removedTextures) do
        if obj and data.Parent then pcall(function() obj.Parent = data.Parent end) end
    end
    removedTextures = {}
    if savedLighting then
        pcall(function()
            Lighting.ClockTime = savedLighting.ClockTime
            Lighting.Brightness = savedLighting.Brightness
            Lighting.Ambient = savedLighting.Ambient
            Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
            Lighting.FogColor = savedLighting.FogColor
            Lighting.FogEnd = savedLighting.FogEnd
            Lighting.FogStart = savedLighting.FogStart
            Lighting.GlobalShadows = savedLighting.GlobalShadows
            Lighting.EnvironmentDiffuseScale = savedLighting.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = savedLighting.EnvironmentSpecularScale
        end)
        savedLighting = nil
    end
    if removedSky and removedSkyParent then
        pcall(function() removedSky.Parent = removedSkyParent end)
        removedSky = nil; removedSkyParent = nil
    end
end

-- ========== NOCLIP ==========
local noclipConnection = nil
local function setNoclip(enabled)
    if enabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if not FARM_ENABLED and not CANDY_ENABLED and not PINATA_ENABLED then return end
                local character = LocalPlayer.Character
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = (part.Name == "HumanoidRootPart")
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
            local character = LocalPlayer.Character
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    end
end

