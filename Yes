-- ========== KNOCK ATTEMPT ==========
local function tryKnock(prompt)
    if not prompt then return false end
    local ok, success = pcall(function()
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
                return true
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.3)
                prompt:InputHoldEnd()
                return true
            end
        end
        return false
    end)
    return ok and success or false
end

-- ========== WAIT FOR DOOR CHANGE ==========
local function waitForDoorChange(doorPart, doorPrompt, doorModel)
    local startName = doorModel and doorModel.Name or (doorPart and doorPart.Name)
    local startPromptObj = doorPrompt and doorPrompt.ObjectText or ""
    local startAction = doorPrompt and doorPrompt.ActionText or ""
    local startParent = doorPart and doorPart.Parent
    local startTime = tick()
    local maxWait = 5
    while tick() - startTime < maxWait do
        if not FARM_ENABLED or isDead or PINATA_ENABLED then break end
        local gone = (not doorPart) or (not doorPart:IsDescendantOf(workspace))
        local promptGone = (not doorPrompt) or (not doorPrompt:IsDescendantOf(workspace))
        local modelRenamed = doorModel and doorModel.Parent and doorModel.Name ~= startName
        local partReplaced = doorPart and doorPart.Parent ~= startParent
        local promptChanged = doorPrompt and (doorPrompt.ObjectText ~= startPromptObj or doorPrompt.ActionText ~= startAction)
        if gone or promptGone or modelRenamed or partReplaced or promptChanged then return true end
        task.wait(0.1)
    end
    return false
end

-- ========== MAIN FARM LOOP ==========
local farmThread = nil
local function startFarm()
    if farmThread then task.cancel(farmThread) end
    setNoclip(true)
    farmThread = task.spawn(function()
        if _G.setStatus then _G.setStatus("Farming...", THEME.SUCCESS) end
        local lastDoorPart = nil
        while FARM_ENABLED or CANDY_ENABLED or PINATA_ENABLED do
            task.wait(0.05)
            if isDead then task.wait(1); continue end

            if PINATA_ENABLED then
                stopPlatformLock()
                local penyta, hrp = findPinata()
                if penyta and hrp then
                    if FARM_ENABLED then FARM_ENABLED = false; toggleBtn.Text = "◉  AUTO FARM: OFF"; setButtonState(toggleBtn, false) end
                    if CANDY_ENABLED then CANDY_ENABLED = false; candyBtn.Text = "◉  AUTO CANDY: OFF"; setButtonState(candyBtn, false) end
                    clearAllChams()
                    applyChams(penyta, 1, PINATA_CHAMS_COLOR)
                    if _G.setStatus then _G.setStatus("Piñata! Attacking...", THEME.PINATA) end

                    local belowCF = hrp.CFrame * CFrame.new(0, -PINATA_BELOW_DISTANCE, 0)
                    instantTeleportTo(belowCF)
                    startSkillSpam()

                    while PINATA_ENABLED and not isDead do
                        local p, h = findPinata()
                        if not p or not h or not p:IsDescendantOf(workspace) then break end
                        local char = LocalPlayer.Character
                        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local target = h.Position - Vector3.new(0, PINATA_BELOW_DISTANCE, 0)
                            myHrp.CFrame = CFrame.new(target, target + h.CFrame.LookVector)
                            myHrp.AssemblyLinearVelocity = Vector3.zero
                            myHrp.AssemblyAngularVelocity = Vector3.zero
                        end
                        local hp = "?"
                        pcall(function()
                            local hum = p:FindFirstChildOfClass("Humanoid")
                            if hum then hp = math.floor(hum.Health) end
                        end)
                        if _G.setStatus then _G.setStatus("Piñata HP: " .. tostring(hp), THEME.PINATA) end
                        task.wait(0.1)
                    end

                    stopSkillSpam()
                    clearAllChams()
                    if PINATA_ENABLED then
                        if _G.setStatus then _G.setStatus("Piñata gone! Restoring...", THEME.SUCCESS) end
                        FARM_ENABLED = true; toggleBtn.Text = "◉  AUTO FARM: ON"; setButtonState(toggleBtn, true)
                        CANDY_ENABLED = true; candyBtn.Text = "◉  AUTO CANDY: ON"; setButtonState(candyBtn, true)
                    end
                else
                    if _G.setStatus then _G.setStatus("Piñata: Waiting...", THEME.MUTED) end
                end
            end

            if not PINATA_ENABLED or not findPinata() then
                if CANDY_ENABLED then
                    local _, _, candyCount = findCandyTarget()
                    if candyCount > 0 then
                        stopPlatformLock()
                        if FARM_ENABLED then FARM_ENABLED = false; toggleBtn.Text = "◉  AUTO FARM: OFF"; setButtonState(toggleBtn, false) end
                        if _G.setStatus then _G.setStatus("Candy Detected!", CANDY_CHAMS_COLOR) end
                        collectAllCandy()
                        if CANDY_ENABLED and not FARM_ENABLED and not PINATA_ENABLED then
                            FARM_ENABLED = true; toggleBtn.Text = "◉  AUTO FARM: ON"; setButtonState(toggleBtn, true)
                        end
                    end
                end

                if FARM_ENABLED then
                    if FARMING_MODE == "Tween" then
                        local currentTarget, currentPrompt, currentModel = findDoorTarget()
                        if currentTarget and currentPrompt then
                            clearAllChams()
                            applyChams(currentTarget, 1)
                            applyChams(currentModel or currentTarget.Parent, 2)
                            local doorGroundCFrame = currentTarget.CFrame * CFrame.new(0, 0, INTERACT_DISTANCE)
                            local doorSkyCFrame = doorGroundCFrame * CFrame.new(0, AIR_HEIGHT, 0)
                            if _G.setStatus then _G.setStatus("Door: " .. currentTarget.Name, THEME.SUCCESS) end
                            forceTweenTo(doorSkyCFrame)
                            forceTweenTo(doorGroundCFrame)
                            if _G.setStatus then _G.setStatus("Trick or Treat!", THEME.SUCCESS) end
                            tryKnock(currentPrompt)
                            task.wait(WAIT_AT_DOOR)
                            forceTweenTo(doorSkyCFrame)
                            task.wait(COOLDOWN_DURATION)
                        else
                            if not CANDY_ENABLED and not PINATA_ENABLED then if _G.setStatus then _G.setStatus("No doors found", THEME.MUTED) end end
                            task.wait(0.5)
                        end
                    else
                        local targetPart, targetPrompt, targetModel = findFarthestDoorTarget(lastDoorPart)
                        if targetPart and targetPrompt then
                            stopPlatformLock()
                            clearAllChams()
                            applyChams(targetPart, 1, THEME.TP_MODE)
                            applyChams(targetModel or targetPart.Parent, 2, THEME.TP_MODE)
                            local doorGroundCFrame = targetPart.CFrame * CFrame.new(0, 0, INTERACT_DISTANCE)
                            if _G.setStatus then _G.setStatus("TP: Farthest door", THEME.TP_MODE) end
                            instantTeleportTo(doorGroundCFrame)
                            task.wait(TP_STAY_AT_DOOR)
                            if not FARM_ENABLED or isDead or PINATA_ENABLED then continue end

                            if _G.setStatus then _G.setStatus("TP: Knocking...", THEME.TP_MODE) end
                            local success = tryKnock(targetPrompt)
                            lastDoorPart = targetPart

                            if _G.setStatus then _G.setStatus("TP: Returning to platform", THEME.TP_MODE) end
                            local platCF = getSkyPlatformCFrame()
                            if platCF then
                                instantTeleportTo(platCF)
                                startPlatformLock(platCF)
                            end

                            if not success then
                                if _G.setStatus then _G.setStatus("TP: Knock failed! Next door...", THEME.DANGER) end
                                stopPlatformLock()
                                task.wait(0.15)
                                continue
                            end

                            if _G.setStatus then _G.setStatus("TP: Waiting for tree...", THEME.TP_MODE) end
                            local changed = waitForDoorChange(targetPart, targetPrompt, targetModel)
                            if not FARM_ENABLED or isDead or PINATA_ENABLED then stopPlatformLock(); continue end

                            if not changed then
                                if _G.setStatus then _G.setStatus("TP: No tree change! Next door...", THEME.DANGER) end
                                stopPlatformLock()
                                task.wait(0.15)
                                continue
                            end

                            if _G.setStatus then _G.setStatus("TP: Waiting 2s...", THEME.TP_MODE) end
                            task.wait(TP_POST_CHANGE_WAIT)
                        else
                            if not CANDY_ENABLED and not PINATA_ENABLED then if _G.setStatus then _G.setStatus("No doors found", THEME.MUTED) end end
                            task.wait(0.5)
                        end
                    end
                elseif CANDY_ENABLED and not PINATA_ENABLED then
                    if _G.setStatus then _G.setStatus("Waiting for candy...", THEME.MUTED) end
                    task.wait(0.5)
                end
            end
        end
        clearAllChams()
        stopSkillSpam()
        stopPlatformLock()
        if _G.setStatus then _G.setStatus("Stopped", THEME.MUTED) end
    end)
end

local function stopFarm()
    FARM_ENABLED = false
    CANDY_ENABLED = false
    PINATA_ENABLED = false
    stopPlatformLock()
    clearAllChams()
    stopSkillSpam()
    removeSkyPlatform()
    if currentTween then currentTween:Cancel(); currentTween = nil end
    setNoclip(false)
    if farmThread then task.cancel(farmThread); farmThread = nil end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    if _G.setStatus then _G.setStatus("Off", THEME.MUTED) end
end

